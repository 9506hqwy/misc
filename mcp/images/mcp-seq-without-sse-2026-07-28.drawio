        <mxCell id="ou3i-DjhDcNJm9sdVRFP-48" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;クライアントは下記を指定する。&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;・Accept ヘッダ (&lt;b&gt;MUST&lt;/b&gt;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;・Mcp-Method ヘッダ (&lt;span data-as=&quot;p&quot;&gt;&lt;strong&gt;REQUIRED&lt;/strong&gt;&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;・Mcp-Name ヘッダ (&lt;span data-as=&quot;p&quot;&gt;&lt;strong&gt;REQUIRED&lt;/strong&gt;&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;&lt;code&gt;Mcp-Name は必要な場合に base64 でエンコード (&lt;b&gt;MUST&lt;/b&gt;)&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;&lt;br&gt;&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;_metaは下記がある。&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;・&lt;/code&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;io.modelcontextprotocol/protocolVersion (&lt;b&gt;MUST&lt;/b&gt;)&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;code&gt;・&lt;/code&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;io.modelcontextprotocol/clientCapabilities&lt;/code&gt;&lt;/span&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt; (&lt;b&gt;MUST&lt;/b&gt;)&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;・&lt;/code&gt;&lt;/span&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;io.modelcontextprotocol/clientInfo (&lt;b&gt;SHOULD&lt;/b&gt;)&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;・&lt;/code&gt;&lt;/span&gt;&lt;span data-as=&quot;p&quot;&gt;&lt;code&gt;io.modelcontextprotocol/logLevel&lt;/code&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
